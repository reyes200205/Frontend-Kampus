# URL base de la API de Laravel. En un celular físico usa la IP de tu PC en la red local
# (ej. http://192.168.1.50:8000/api), no localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Tiempo real del chat con Laravel Reverb (T-16). Usa la misma REVERB_APP_KEY del .env del backend
# (nunca el secreto). En un celular físico, REVERB_HOST es la IP de tu PC. Si dejas vacía la clave,
# el chat funciona igual pero se actualiza cada 8 segundos en lugar de al instante.
EXPO_PUBLIC_REVERB_APP_KEY=
EXPO_PUBLIC_REVERB_HOST=localhost
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http